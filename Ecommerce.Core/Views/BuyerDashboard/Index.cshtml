@{
    Layout = "~/Views/Shared/_dashboardSeller.cshtml";
}

<div class="w-100 p-3 d-flex align-items-center flex-column ">
    <!--all products view-->
    <div id="ProductsContainer" class=" mt-4">

    </div>
    <div class="d-flex justify-content-center m-5">
        <span class="loader3" style="width: 40px; height: 40px;"></span>
    </div>
    <!-- Pagination Controls -->
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-end align-items-center px-2 d-lg-flex d-sm-flex gap-2">
            <div class="d-flex align-items-center mb-1 mt-2">
                <span>Items per page:   </span>
                <div class="custom-dropdown">
                    <button class="btn border bg-white text-black" type="button" id="itemsPerPageBtn">
                        1 <span><i class="bi bi-chevron-down"></i></span>
                    </button>
                    <div class="custom-dropdown-menu" id="itemsPerPageMenu" style="display: none;">
                        <div class="page-size-option text-black" data-size="25">25</div>
                        <div class="page-size-option text-black" data-size="50">50</div>
                        <div class="page-size-option text-black" data-size="100">100</div>
                    </div>
                </div>
            </div>
            <div class="d-flex align-items-center mb-1 mt-2 gap-2">
                <span id="pagination-info">Showing 1-2 of 0</span>
                <li class="page-item">
                    <a class="page-link rounded-2" id="prevPage" href="#">
                        <i class="bi bi-chevron-left"></i> 
                    </a>
                </li>
                <li>
                    <span class="currentPage text-color">
                        1
                    </span>
                </li>
                <li class="page-item">
                    <a class="page-link rounded-2" id="nextPage" href="#"> 
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </div>
        </ul>
    </nav>
    <footer>
        <p class="text-color">Copyright© @DateTime.Now.Year </p>
    </footer>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        window.successMessage = '@TempData["SuccessMessage"]';
        window.errorMessage = '@TempData["ErrorMessage"]';


    </script>
    <script src="~/js/toastr_script.js"></script>
    <script src="~/js/BuyerDashboardIndex_script.js" asp-append-version="true"></script>
}